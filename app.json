{
  "expo": {
    "name": "visagel",
    "slug": "visagel-face-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/visagel.png",
    "scheme": "visagel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.branzept.visagel"
    },
    "android": {
      "package": "com.branzept.visagel",
      "adaptiveIcon": {
        "backgroundColor": "#00A86B",
        "foregroundImage": "./assets/images/visagel.png",
        "backgroundImage": "./assets/images/visagel.png",
        "monochromeImage": "./assets/images/visagel.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/visagel.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/visagel.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00A86B",
          "dark": {
            "backgroundColor": "#00A86B"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Visagel to access your camera for wall-mounted face attendance scanning."
        }
      ],
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
